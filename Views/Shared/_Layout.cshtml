<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NeuroSync</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        :root {
            --navy: #071A3A;
            --primary: #315BEF;
            --bg-light: #F4F7FE;
            --text-dark: #2B3674;
            --text-muted: #A3AED0;
        }

        body { 
            background-color: var(--bg-light); 
            color: var(--text-dark); 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            margin: 0;
            overflow-x: hidden;
        }

        /* --- MENU LATERAL (SIDEBAR) --- */
        .sidebar { 
            width: 260px; 
            height: 100vh; 
            background-color: var(--navy); 
            position: fixed; 
            top: 0; 
            left: 0; 
            overflow-y: auto; 
            z-index: 1000;
        }

        .nav-link-custom { 
            color: rgba(255,255,255,0.6); 
            margin: 4px 16px; 
            border-radius: 8px; 
            padding: 12px 16px; 
            display: flex; 
            align-items: center; 
            gap: 12px; 
            font-weight: 500; 
            transition: 0.3s; 
            text-decoration: none;
            font-size: 0.95rem;
        }

        .nav-link-custom:hover { color: white; background-color: rgba(255,255,255,0.05); }
        .nav-link-custom.active { background-color: var(--primary); color: white; }
        .nav-icon { font-size: 1.2rem; }

        /* --- ÁREA DE CONTEÚDO PRINCIPAL --- */
        .main-content { 
            margin-left: 260px; 
            min-height: 100vh; 
            padding: 30px 40px; 
        }

        .top-bar { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            margin-bottom: 40px; 
        }

        .search-bar { 
            background: white; 
            border-radius: 20px; 
            padding: 10px 20px; 
            display: flex; 
            align-items: center; 
            gap: 10px; 
            width: 350px; 
            box-shadow: 0 2px 15px rgba(0,0,0,0.02); 
        }

        .search-bar input { 
            border: none; 
            outline: none; 
            background: transparent; 
            width: 100%; 
            font-size: 0.9rem;
            color: var(--text-dark);
        }
    </style>
</head>
<body>
    
    <!-- SIDEBAR -->
    <div class="sidebar d-flex flex-column py-4 shadow-lg">
        <!-- Logo -->
        <div class="d-flex align-items-center px-4 mb-5">
            <i class="bi bi-modem text-primary fs-3 me-2"></i>
            <h4 class="text-white fw-bold mb-0">Neuro<span class="text-info">Sync</span></h4>
        </div>
        
        <!-- Links de Navegação -->
        <nav class="flex-grow-1">
            <a href="/Home" class="nav-link-custom active"><i class="bi bi-grid-1x2-fill nav-icon"></i> Dashboard</a>
            <a href="/Pacientes" class="nav-link-custom"><i class="bi bi-person nav-icon"></i> Pacientes</a>
            <a href="/Agenda" class="nav-link-custom"><i class="bi bi-calendar-event nav-icon"></i> Agenda</a>
            <a href="/Prontuarios" class="nav-link-custom"><i class="bi bi-file-earmark-medical nav-icon"></i> Prontuários</a>
            <a href="/Terapias" class="nav-link-custom"><i class="bi bi-puzzle nav-icon"></i> Terapias</a>
            <a href="/Relatorios" class="nav-link-custom"><i class="bi bi-bar-chart nav-icon"></i> Relatórios</a>
            <a href="/Financeiro" class="nav-link-custom"><i class="bi bi-wallet2 nav-icon"></i> Financeiro</a>
        </nav>

        <!-- Links de Rodapé do Menu (O botão Sair aponta para o seu Controller!) -->
        <div class="mt-auto pt-3 border-top border-secondary border-opacity-25 px-2">
            <a href="/Configuracoes" class="nav-link-custom"><i class="bi bi-gear nav-icon"></i> Configurações</a>
            <a href="/Login/Sair" class="nav-link-custom"><i class="bi bi-box-arrow-left nav-icon text-danger"></i> Sair</a>
        </div>
    </div>

    <!-- MAIN CONTENT (Onde as telas aparecem) -->
    <div class="main-content">
        <!-- Cabeçalho (Título e Busca) -->
        <div class="top-bar">
            <h3 class="fw-bold mb-0" style="color: var(--text-dark);">@ViewData["Title"]</h3>
            <div class="search-bar">
                <i class="bi bi-search text-muted"></i>
                <input type="text" placeholder="Buscar pacientes, prontuários..." />
            </div>
        </div>
        
        <!-- O miolo de cada página é injetado aqui dentro -->
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>