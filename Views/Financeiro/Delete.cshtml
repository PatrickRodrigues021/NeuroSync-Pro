@model NeuroSync.Models.Cobranca

@{
    ViewData["Title"] = "Excluir Cobrança";
}

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="card shadow border-danger" style="max-width: 500px; width: 100%;">
        <div class="card-header bg-danger text-white py-3">
            <h4 class="mb-0"><i class="bi bi-trash-fill me-2"></i> Confirmar Exclusão</h4>
        </div>
        <div class="card-body p-4">
            <h5 class="text-center mb-4">Tem certeza de que deseja apagar esta cobrança?</h5>
            
            <!-- Resumo da Cobrança -->
            <div class="bg-light p-3 rounded mb-4">
                <p class="mb-1"><strong>Paciente:</strong> @(Model.Paciente != null ? Model.Paciente.Nome : "Excluído")</p>
                <p class="mb-1"><strong>Descrição:</strong> @Model.Descricao</p>
                <p class="mb-1"><strong>Vencimento:</strong> @Model.DataVencimento.ToString("dd/MM/yyyy")</p>
                <p class="mb-0"><strong>Status Atual:</strong> 
                    <span class="text-danger fw-bold">@Model.Status</span>
                </p>
            </div>
            
            <p class="text-danger small text-center mb-4">
                <strong>Atenção:</strong> Esta ação é irreversível. O registro financeiro será completamente removido do sistema.
            </p>

            <form asp-action="Delete" method="post" class="d-flex justify-content-between">
                <!-- O ID escondido -->
                <input type="hidden" asp-for="IdCobranca" />
                
                <a asp-action="Index" class="btn btn-secondary px-4 fw-bold">Voltar</a>
                <button type="submit" class="btn btn-danger px-4 fw-bold"><i class="bi bi-trash"></i> Sim, Apagar</button>
            </form>
        </div>
    </div>
</div>