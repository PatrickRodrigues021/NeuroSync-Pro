@model NeuroSync.Models.Cobranca

@{
    ViewData["Title"] = "Nova Cobrança";
}

<div class="container mt-4 mb-5">
    <h2 class="text-warning text-darken-2"><i class="bi bi-cash-coin"></i> Lançar Cobrança</h2>
    <p class="text-muted">Gere uma nova cobrança de mensalidade ou sessão avulsa.</p>
    <hr />

    <div class="card shadow-sm border-0 mt-4" style="max-width: 600px;">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                
                <!-- Seleção do Paciente -->
                <div class="mb-4">
                    <label asp-for="PacienteId" class="control-label fw-bold">Paciente (Pagador) *</label>
                    <select asp-for="PacienteId" id="buscaPaciente" class="form-select" asp-items="ViewBag.Pacientes" required>
                        <option value="">-- Buscar paciente... --</option>
                    </select>
                </div>

                <!-- Descrição da Cobrança -->
                <div class="mb-4">
                    <label asp-for="Descricao" class="control-label fw-bold">Descrição da Cobrança *</label>
                    <input asp-for="Descricao" class="form-control" placeholder="Ex: Mensalidade de Agosto ou Sessão Avulsa 30/08" required />
                </div>

                <div class="row">
                    <!-- Valor -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="Valor" class="control-label fw-bold">Valor (R$) *</label>
                        <input asp-for="Valor" type="number" step="0.01" class="form-control" placeholder="150,00" required />
                    </div>
                    
                    <!-- Data de Vencimento -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="DataVencimento" class="control-label fw-bold">Data de Vencimento *</label>
                        <input asp-for="DataVencimento" type="date" class="form-control" required />
                    </div>
                </div>

                <!-- Status inicial sempre é Pendente -->
                <input type="hidden" asp-for="Status" value="Pendente" />

                <div class="text-end mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-2">Cancelar</a>
                    <button type="submit" class="btn btn-warning fw-bold text-dark"><i class="bi bi-check-lg"></i> Gerar Cobrança</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#buscaPaciente').select2({ width: '100%' });
        });
    </script>
}