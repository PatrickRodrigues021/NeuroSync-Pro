@model NeuroSync.Models.Paciente

@{
    ViewData["Title"] = "Prontuário de " + Model.Nome;
}

<div class="container mt-4 mb-5">
    
    <!-- Cabeçalho do Prontuário -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-secondary mb-0"><i class="bi bi-person-vcard text-primary me-2"></i> @Model.Nome</h2>
            <small class="text-muted ms-5">Cadastrado em: @Model.CriadoEm.ToString("dd/MM/yyyy")</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold shadow-sm">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>

    <!-- NAVEGAÇÃO DAS ABAS -->
    <ul class="nav nav-tabs" id="prontuarioTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold text-dark" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">
                <i class="bi bi-info-circle text-primary"></i> Dados e Anamnese
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-dark" data-bs-toggle="tab" data-bs-target="#evolucao" type="button" role="tab">
                <i class="bi bi-journal-medical text-success"></i> Evoluções
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-dark" data-bs-toggle="tab" data-bs-target="#agenda" type="button" role="tab">
                <i class="bi bi-calendar-event text-warning"></i> Próximos Atendimentos
            </button>
        </li>
        <!-- CÓDIGO NOVO: Botão da Aba de Arquivos -->
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-dark" data-bs-toggle="tab" data-bs-target="#arquivos" type="button" role="tab">
                <i class="bi bi-file-earmark-pdf text-danger"></i> Exames e Arquivos
            </button>
        </li>
    </ul>

    <!-- CONTEÚDO DAS ABAS -->
    <div class="tab-content bg-white border border-top-0 p-4 rounded-bottom shadow-sm" id="prontuarioTabsContent">
        
        <!-- ABA 1: DADOS PESSOAIS E CLÍNICOS -->
        <div class="tab-pane fade show active" id="info" role="tabpanel">
            <div class="row">
                <div class="col-md-6 border-end">
                    <h5 class="text-primary mb-3">Informações Pessoais</h5>
                    <p class="mb-2"><strong>Idade:</strong> @Model.Idade anos</p>
                    <p class="mb-2"><strong>Responsável:</strong> @(Model.NomeMae ?? Model.NomePai ?? "Não informado")</p>
                    <p class="mb-2"><strong>Telefone:</strong> @Model.Telefone</p>
                    <p class="mb-2"><strong>Endereço:</strong> @(Model.Endereco ?? "Não cadastrado")</p>
                </div>
                <div class="col-md-6 ps-md-4">
                    <h5 class="text-primary mb-3">Quadro Clínico (Anamnese)</h5>
                    <p class="mb-2 text-danger"><strong>Diagnóstico:</strong> @(Model.DiagnosticoPrincipal ?? "Pendente de avaliação")</p>
                    <p class="mb-2"><strong>Medicamentos:</strong> @(Model.MedicamentosContinuos ?? "Nenhum informado")</p>
                    <p class="mb-2 text-success"><strong>Metas (Curto Prazo):</strong> @(Model.MetasCurtoPrazo ?? "A definir")</p>
                    <p class="mb-2 text-primary"><strong>Metas (Longo Prazo):</strong> @(Model.MetasLongoPrazo ?? "A definir")</p>
                </div>
            </div>
            <hr class="mt-4">
            <a asp-action="Edit" asp-route-id="@Model.IdPaciente" class="btn btn-warning fw-bold text-dark">
                <i class="bi bi-pencil-square"></i> Atualizar Ficha e Anamnese
            </a>
        </div>

        <!-- ABA 2: EVOLUÇÕES DA SESSÃO -->
        <div class="tab-pane fade" id="evolucao" role="tabpanel">
            
            <!-- Formulário Rápido para nova evolução -->
            <form asp-action="AdicionarEvolucao" method="post" class="mb-4 bg-light p-3 rounded border">
                <input type="hidden" name="PacienteId" value="@Model.IdPaciente" />
                <label class="fw-bold mb-2 text-success"><i class="bi bi-plus-circle"></i> Nova Evolução da Sessão</label>
                <textarea name="Anotacao" class="form-control mb-3 shadow-sm" rows="3" placeholder="Descreva como foi o atendimento, evolução do paciente e observações..." required></textarea>
                <button type="submit" class="btn btn-success fw-bold">Salvar Anotação</button>
            </form>

            <!-- Histórico de Evoluções (Timeline) -->
            <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">Histórico de Atendimentos</h6>
            
            @if (ViewBag.Evolucoes != null && ViewBag.Evolucoes.Count > 0)
            {
                <div class="mt-3">
                    @foreach (var evo in ViewBag.Evolucoes)
                    {
                        <div class="card mb-3 border-0 shadow-sm border-start border-4 border-success bg-light">
                            <div class="card-body py-2 px-3">
                                <small class="text-muted fw-bold d-block mb-1">
                                    <i class="bi bi-clock-history"></i> Registrado em: @evo.DataRegistro.ToString("dd/MM/yyyy 'às' HH:mm")
                                </small>
                                <p class="mb-0" style="white-space: pre-wrap;">@evo.Anotacao</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-journal-x fs-2 d-block mb-2 opacity-50"></i>
                    Nenhuma evolução registrada para este paciente ainda.
                </div>
            }
        </div>

        <!-- ABA 3: AGENDA -->
        <div class="tab-pane fade" id="agenda" role="tabpanel">
            <h5 class="text-primary mb-3">Próximos Atendimentos</h5>
            @if (ViewBag.Agendamentos != null && ViewBag.Agendamentos.Count > 0)
            {
                <div class="list-group shadow-sm">
                    @foreach(var ag in ViewBag.Agendamentos)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="fw-bold"><i class="bi bi-calendar me-2"></i> @ag.DataHora.ToString("dd/MM/yyyy") às @ag.DataHora.ToString("HH:mm")</span>
                            <span class="badge bg-warning text-dark rounded-pill">@ag.Status</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-calendar2-x fs-2 d-block mb-2 opacity-50"></i>
                    Nenhum agendamento futuro marcado para este paciente.
                </div>
            }
        </div>

        <!-- CÓDIGO NOVO: ABA 4: ARQUIVOS E EXAMES -->
        <div class="tab-pane fade" id="arquivos" role="tabpanel">
            <div class="row">
                
                <!-- Formulário de Upload -->
                <div class="col-md-5 border-end pe-md-4">
                    <h6 class="text-primary mb-3"><i class="bi bi-cloud-upload"></i> Anexar Novo Documento</h6>
                    <form asp-action="UploadArquivo" method="post" enctype="multipart/form-data" class="bg-light p-3 rounded border">
                        <input type="hidden" name="PacienteId" value="@Model.IdPaciente" />
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Selecione o PDF ou Imagem</label>
                            <input type="file" name="arquivo" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required />
                        </div>
                        
                        <button type="submit" class="btn btn-primary btn-sm fw-bold w-100 shadow-sm">
                            <i class="bi bi-upload"></i> Salvar no Prontuário
                        </button>
                    </form>
                </div>

                <!-- Lista de Arquivos Salvos -->
                <div class="col-md-7 ps-md-4">
                    <h6 class="text-secondary mb-3"><i class="bi bi-folder2-open"></i> Arquivos do Paciente</h6>
                    
                    @if (ViewBag.Anexos != null && ViewBag.Anexos.Count > 0)
                    {
                        <div class="list-group shadow-sm">
                            @foreach(var anexo in ViewBag.Anexos)
                            {
                                <a href="@anexo.CaminhoArquivo" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-file-earmark-text fs-4 text-danger me-2 align-middle"></i>
                                        <span class="fw-bold text-dark small">@anexo.NomeArquivo</span>
                                        <div class="text-muted mt-1" style="font-size: 0.75rem;">Enviado em: @anexo.DataUpload.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                    <i class="bi bi-box-arrow-up-right text-muted"></i>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4 mt-2 bg-light rounded" style="border: 1px dashed #ccc;">
                            <i class="bi bi-file-earmark-x fs-2 d-block mb-2 opacity-50"></i>
                            <small>Nenhum documento anexado ainda.</small>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>