@model NeuroSync.Models.Paciente

@{
    ViewData["Title"] = "Prontuário do Paciente";
}

<style>
    .prontuario-container { background-color: #f1f5f9; padding-bottom: 2rem; }
    
    .patient-header-card { background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.02); padding: 24px; border: 1px solid #f1f5f9; display: flex; align-items: center; gap: 24px; margin-bottom: 24px; }
    .avatar-wrapper { width: 80px; height: 80px; border-radius: 50%; background: #e0e7ff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .patient-name { font-weight: 700; color: var(--text-dark); font-size: 1.25rem; margin-bottom: 4px; }
    .patient-meta { color: var(--text-muted); font-size: 0.9rem; font-weight: 500; }
    
    .info-group { display: flex; flex-direction: column; }
    .info-label { font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; letter-spacing: 0.5px; }
    .info-value { font-weight: 600; color: var(--text-dark); font-size: 0.95rem; }

    .nav-tabs-custom { border-bottom: 2px solid #e2e8f0; gap: 1rem; margin-bottom: 24px; }
    .nav-tabs-custom .nav-link { border: none; color: var(--text-muted); font-weight: 600; padding: 12px 4px; background: transparent; position: relative; margin-bottom: -2px; }
    .nav-tabs-custom .nav-link:hover { color: var(--primary); }
    .nav-tabs-custom .nav-link.active { color: var(--primary); background: transparent; }
    .nav-tabs-custom .nav-link.active::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background-color: var(--primary); border-radius: 2px 2px 0 0; }

    .dashboard-card { background: white; border-radius: 16px; border: 1px solid #f1f5f9; box-shadow: 0 4px 20px rgba(0,0,0,0.02); padding: 24px; height: 100%; }
    .card-title-custom { font-weight: 700; color: var(--text-dark); font-size: 1rem; margin-bottom: 20px; }
    
    .timeline-item { position: relative; padding-left: 20px; margin-bottom: 16px; }
    .timeline-item::before { content: ''; position: absolute; left: 0; top: 6px; width: 8px; height: 8px; border-radius: 50%; background-color: #93c5fd; }
    .timeline-date { font-size: 0.8rem; color: #64748b; font-weight: 600; margin-bottom: 4px; }
    .timeline-text { font-size: 0.9rem; color: #334155; line-height: 1.5; }

    .appointment-item { margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 8px; }
    .appointment-item:last-child { border-bottom: none; }
    .appointment-datetime { font-size: 0.85rem; color: #64748b; font-weight: 600; }
    .appointment-type { font-size: 0.95rem; color: var(--text-dark); font-weight: 600; }
</style>

<div class="prontuario-container">
    
    <div class="d-flex justify-content-between align-items-center mb-4 pt-3">
        <h3 class="fw-bold mb-0" style="color: var(--text-dark);">Prontuário do Paciente</h3>
        <a href="/Prontuarios" class="btn btn-light fw-bold text-muted rounded-pill px-4"><i class="bi bi-arrow-left me-2"></i> Voltar</a>
    </div>

    <!-- CABEÇALHO DO PACIENTE -->
    <div class="patient-header-card">
        <div class="avatar-wrapper">
            <span style="color: #4f46e5; font-weight: bold; font-size: 1.8rem;">
                @Model.Nome.Substring(0, 1).ToUpper()
            </span>
        </div>
        
        <div class="flex-grow-1">
            <h2 class="patient-name">@Model.Nome</h2>
            <div class="patient-meta">
                @Model.Idade anos • @Model.DataNascimento.ToString("dd/MM/yyyy") 
                <br />
                Responsável: @(string.IsNullOrEmpty(Model.NomeMae) ? (string.IsNullOrEmpty(Model.NomePai) ? "Não informado" : Model.NomePai) : Model.NomeMae)
            </div>
        </div>

        <div class="d-flex gap-5 ms-auto pe-3 border-start ps-5">
            <div class="info-group">
                <span class="info-label">Criado em</span>
                <span class="info-value">@Model.CriadoEm.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="info-group">
                <span class="info-label">Status</span>
                <span class="info-value text-success"><i class="bi bi-circle-fill small me-1"></i> Ativo</span>
            </div>
        </div>
    </div>

    <!-- NAVEGAÇÃO POR ABAS -->
    <ul class="nav nav-tabs nav-tabs-custom" id="prontuarioTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="resumo-tab" data-bs-toggle="tab" data-bs-target="#resumo" type="button" role="tab">Resumo</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="anamnese-tab" data-bs-toggle="tab" data-bs-target="#anamnese" type="button" role="tab">Anamnese</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="evolucao-tab" data-bs-toggle="tab" data-bs-target="#evolucao" type="button" role="tab">Evolução</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="atendimentos-tab" data-bs-toggle="tab" data-bs-target="#atendimentos" type="button" role="tab">Atendimentos</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="documentos-tab" data-bs-toggle="tab" data-bs-target="#documentos" type="button" role="tab">Documentos</button>
        </li>
        <!-- NOVA ABA: ANEXOS (Entre Documentos e Financeiro) -->
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="anexos-tab" data-bs-toggle="tab" data-bs-target="#anexos" type="button" role="tab">
                <i class="bi bi-paperclip"></i> Anexos
            </button>
        </li>
        <!-- ABA: FINANCEIRO -->
        <li class="nav-item" role="presentation">
            <button class="nav-link text-success" id="financeiro-tab" data-bs-toggle="tab" data-bs-target="#financeiro" type="button" role="tab">
                <i class="bi bi-currency-dollar"></i> Financeiro
            </button>
        </li>
    </ul>

    <!-- CONTEÚDO DAS ABAS -->
    <div class="tab-content" id="prontuarioTabsContent">
        
        <!-- ABA 1: RESUMO -->
        <div class="tab-pane fade show active" id="resumo" role="tabpanel">
            <div class="row g-4">
                
                <div class="col-md-4">
                    <div class="dashboard-card">
                        <h5 class="card-title-custom">Resumo clínico</h5>
                        
                        <div class="mb-4">
                            <span class="info-label text-primary">Diagnóstico</span>
                            <p class="mt-1 mb-0" style="font-size: 0.95rem; color: #334155;">
                                @(string.IsNullOrEmpty(Model.DiagnosticoPrincipal) ? "Nenhum diagnóstico registrado." : Model.DiagnosticoPrincipal)
                            </p>
                        </div>

                        <div>
                            <span class="info-label text-primary">Objetivos principais</span>
                            <p class="mt-1 mb-0" style="font-size: 0.95rem; color: #334155;">
                                @(string.IsNullOrEmpty(Model.MetasCurtoPrazo) ? "Nenhuma meta definida." : Model.MetasCurtoPrazo)
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="dashboard-card">
                        <h5 class="card-title-custom">Últimas evoluções</h5>
                        
                        @if (ViewBag.UltimasEvolucoes != null && ViewBag.UltimasEvolucoes.Count > 0)
                        {
                            foreach (var evolucao in ViewBag.UltimasEvolucoes)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-date">@evolucao.DataHora.ToString("dd/MM/yyyy - HH:mm")</div>
                                    <div class="timeline-text">Sessão registrada como: <strong>@evolucao.Status</strong>. (Integração com texto da evolução em breve).</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-journal-x text-muted mb-2" style="font-size: 2rem;"></i>
                                <p class="text-muted small">Nenhuma sessão finalizada encontrada.</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="dashboard-card d-flex flex-column">
                        <h5 class="card-title-custom">Próximos atendimentos</h5>
                        
                        @if (ViewBag.ProximosAtendimentos != null && ViewBag.ProximosAtendimentos.Count > 0)
                        {
                            foreach (var agendamento in ViewBag.ProximosAtendimentos)
                            {
                                <div class="appointment-item">
                                    <div class="appointment-datetime">@agendamento.DataHora.ToString("dd/MM/yyyy - HH:mm")</div>
                                    <div class="appointment-type text-primary">@agendamento.Status</div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small text-center mt-3">Nenhum agendamento futuro marcado.</p>
                        }

                        <div class="mt-auto pt-3">
                            <a href="/Agenda" class="btn btn-primary w-100 fw-bold rounded-pill" style="background: var(--primary);">Ver agenda completa</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ABA 2: ANAMNESE -->
        <div class="tab-pane fade" id="anamnese" role="tabpanel">
            <div class="dashboard-card text-center py-5">
                <i class="bi bi-file-earmark-medical text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 fw-bold text-muted">Anamnese</h5>
                <a href="/Pacientes/Edit/@Model.IdPaciente" class="btn btn-outline-primary fw-bold rounded-pill mt-2">Editar Dados Clínicos</a>
            </div>
        </div>

        <div class="tab-pane fade" id="evolucao" role="tabpanel"><div class="dashboard-card p-4">Em construção...</div></div>
        
        <div class="tab-pane fade" id="atendimentos" role="tabpanel"><div class="dashboard-card p-4">Em construção...</div></div>

        <!-- ABA 5: DOCUMENTOS (Aba original, vazia para usos futuros) -->
        <div class="tab-pane fade" id="documentos" role="tabpanel">
            <div class="dashboard-card p-4 text-center">
                <i class="bi bi-file-earmark-text text-muted mb-3" style="font-size: 3rem;"></i>
                <h5 class="fw-bold text-muted">Geração de Documentos</h5>
                <p class="text-muted small">Módulo em construção para emissão de atestados, recibos e laudos pelo sistema.</p>
            </div>
        </div>

        <!-- ABA 6: ANEXOS (Onde fica o upload!) -->
        <div class="tab-pane fade" id="anexos" role="tabpanel">
            <div class="row g-4">
                
                <!-- Coluna 1: Formulário de Upload -->
                <div class="col-md-4">
                    <div class="dashboard-card">
                        <h5 class="fw-bold text-dark mb-4">Novo Anexo</h5>
                        
                        <form asp-action="UploadAnexo" asp-controller="Pacientes" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="pacienteId" value="@Model.IdPaciente" />
                            
                            <div class="mb-3">
                                <label class="form-label text-muted fw-bold small">Selecione o arquivo (PDF, Imagens)</label>
                                <input type="file" name="arquivoUpload" class="form-control" required />
                            </div>
                            
                            <button type="submit" class="btn btn-primary w-100 fw-bold rounded-pill shadow-sm">
                                <i class="bi bi-cloud-arrow-up me-2"></i> Fazer Upload
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Coluna 2: Lista de Documentos Anexados -->
                <div class="col-md-8">
                    <div class="dashboard-card">
                        <h5 class="fw-bold text-dark mb-4">Arquivos do Paciente</h5>
                        
                        @if (ViewBag.Anexos != null && ViewBag.Anexos.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="text-muted small text-uppercase">
                                        <tr>
                                            <th>Nome do Arquivo</th>
                                            <th>Data</th>
                                            <th class="text-end">Ação</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var anexo in ViewBag.Anexos)
                                        {
                                            <tr>
                                                <td>
                                                    <i class="bi bi-file-earmark-pdf text-danger me-2"></i> 
                                                    <span class="fw-semibold text-dark">@anexo.NomeArquivo</span>
                                                </td>
                                                <td class="text-muted small">@anexo.DataUpload.ToString("dd/MM/yyyy - HH:mm")</td>
                                                <td class="text-end">
                                                    <a href="@anexo.CaminhoArquivo" target="_blank" class="btn btn-sm btn-light text-primary fw-bold rounded-pill px-3">
                                                        <i class="bi bi-download me-1"></i> Baixar
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-folder-x text-muted mb-3" style="font-size: 3rem;"></i>
                                <h5 class="fw-bold text-muted">Nenhum anexo encontrado</h5>
                                <p class="text-muted small">Faça o upload de exames e laudos externos ao lado.</p>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>

        <!-- ABA 7: FINANCEIRO -->
        <div class="tab-pane fade" id="financeiro" role="tabpanel">
            <div class="dashboard-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h5 class="fw-bold text-dark mb-0">Controle Financeiro</h5>
                    <button class="btn btn-success fw-bold rounded-pill px-4 shadow-sm">
                        <i class="bi bi-plus-lg me-1"></i> Nova Cobrança
                    </button>
                </div>
                
                <div class="text-center py-5">
                    <i class="bi bi-wallet2 text-muted mb-3" style="font-size: 3.5rem;"></i>
                    <h5 class="fw-bold text-muted">Nenhuma cobrança registrada</h5>
                    <p class="text-muted">Aqui você poderá gerenciar pagamentos, sessões avulsas e pacotes mensais deste paciente.</p>
                </div>
            </div>
        </div>

    </div>
</div>