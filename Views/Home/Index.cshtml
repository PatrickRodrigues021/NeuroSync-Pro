@model IEnumerable<NeuroSync.Models.Paciente>

@{
    ViewData["Title"] = "Painel Inicial";
}

<div class="container-fluid mt-4 mb-5">
    <h2 class="mb-4 text-secondary"><i class="bi bi-graph-up-arrow"></i> Visão Geral</h2>

    <!-- LINHA 1: CARTÕES DE RESUMO (Métricas Rápidas) -->
    <div class="row mb-5">
        
        <!-- Cartão 1: Total de Pacientes -->
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-primary shadow-sm h-100 border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase text-white-50 fw-bold">Total de Pacientes</h6>
                        <h2 class="display-5 mb-0 fw-bold">@ViewBag.TotalPacientes</h2>
                    </div>
                    <i class="bi bi-people-fill" style="font-size: 3.5rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>

        <!-- Cartão 2: Consultas Hoje -->
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-success shadow-sm h-100 border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase text-white-50 fw-bold">Consultas Hoje</h6>
                        <h2 class="display-5 mb-0 fw-bold">@ViewBag.ConsultasHoje</h2>
                    </div>
                    <i class="bi bi-calendar-check-fill" style="font-size: 3.5rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>

        <!-- Cartão 3: Financeiro -->
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-warning shadow-sm h-100 border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase text-dark-50 fw-bold">A Receber no Mês</h6>
                        <h2 class="display-5 mb-0 text-dark fw-bold">@ViewBag.TotalReceberMes.ToString("C")</h2>
                    </div>
                    <i class="bi bi-currency-dollar text-dark" style="font-size: 3.5rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- LINHA 2: CONTEÚDO PRINCIPAL (Tabela + Calendário) -->
    <div class="row">
        
        <!-- LADO ESQUERDO: TABELA DE PACIENTES (Ocupa 8 colunas) -->
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                    <h5 class="mb-0 text-secondary fw-bold"><i class="bi bi-person-lines-fill"></i> Últimos Pacientes Cadastrados</h5>
                    <a asp-controller="Pacientes" asp-action="Create" class="btn btn-sm btn-primary fw-bold">+ Novo Paciente</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th class="ps-4">Nome do Paciente</th>
                                    <th>Idade</th>
                                    <th>Responsável</th>
                                    <th>Data de Cadastro</th>
                                    <th class="text-end pe-4">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var paciente in Model.OrderByDescending(p => p.CriadoEm).Take(5))
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold text-dark">@paciente.Nome</td>
                                            <td>@paciente.Idade anos</td>
                                            <td>@(paciente.NomeMae ?? paciente.NomePai ?? "Não informado")</td>
                                            <td>@paciente.CriadoEm.ToString("dd/MM/yyyy")</td>
                                            <td class="text-end pe-4">
                                                <a asp-controller="Pacientes" asp-action="Edit" asp-route-id="@paciente.IdPaciente" class="btn btn-sm btn-outline-warning fw-bold text-dark me-1" title="Editar Cadastro">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a asp-controller="Pacientes" asp-action="Delete" asp-route-id="@paciente.IdPaciente" class="btn btn-sm btn-outline-danger fw-bold me-1" title="Excluir Paciente">
                                                    <i class="bi bi-trash-fill"></i>
                                                </a>
                                                <a asp-controller="Pacientes" asp-action="Details" asp-route-id="@paciente.IdPaciente" class="btn btn-sm btn-outline-info fw-bold" title="Abrir Prontuário">
                                                    <i class="bi bi-folder2-open"></i> Prontuário
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                            Nenhum paciente cadastrado ainda.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

<!-- LADO DIREITO: MINI CALENDÁRIO (Versão Premium com Avatares) -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 12px;">
                <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <h6 class="mb-0 text-dark fw-bold"><i class="bi bi-calendar-day text-primary me-2"></i>Agenda do Dia</h6>
                    <a asp-controller="Agenda" asp-action="Index" class="text-decoration-none small text-primary fw-bold">Ver tudo</a>
                </div>
                
                <div class="card-body pt-0">
                    @if (ViewBag.ProximosAgendamentos != null && ViewBag.ProximosAgendamentos.Count > 0)
                    {
                        <div class="mt-2">
                            @foreach (var agenda in ViewBag.ProximosAgendamentos)
                            {
                                // Configuração de Cores Modernas
                                string statusColor = "bg-primary"; 
                                string statusText = "text-primary"; 
                                string statusBg = "bg-primary-subtle";

                                if (agenda.Status == "Realizado") { 
                                    statusColor = "bg-success"; statusText = "text-success"; statusBg = "bg-success-subtle"; 
                                }
                                if (agenda.Status == "Falta" || agenda.Status == "Cancelado") { 
                                    statusColor = "bg-danger"; statusText = "text-danger"; statusBg = "bg-danger-subtle"; 
                                }

                                // Lógica em C# para pegar a inicial do paciente
                                string pacienteNome = agenda.Paciente != null ? agenda.Paciente.Nome : "Desconhecido";
                                string inicial = !string.IsNullOrEmpty(pacienteNome) ? pacienteNome.Substring(0, 1).ToUpper() : "?";

                                <!-- Mini-Card da Consulta -->
                                <div class="d-flex align-items-center mb-3 p-3 rounded" style="background-color: #f8f9fa; border: 1px solid #f1f1f1;">
                                    
                                    <!-- Avatar com a Inicial -->
                                    <div class="@statusColor text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 45px; height: 45px; font-size: 1.2rem; font-weight: bold; flex-shrink: 0;">
                                        @inicial
                                    </div>

                                    <!-- Informações -->
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.95rem;">@pacienteNome</h6>
                                        <small class="text-muted d-block mt-1" style="font-size: 0.8rem;">
                                            <i class="bi bi-clock"></i> @agenda.DataHora.ToString("HH:mm") &nbsp;&bull;&nbsp; @agenda.DataHora.ToString("dd/MM")
                                        </small>
                                    </div>

                                    <!-- Badge de Status -->
                                    <div class="text-end ms-2">
                                        <span class="badge rounded-pill @statusBg @statusText border-0 px-2 py-1" style="font-size: 0.75rem;">
                                            @agenda.Status
                                        </span>
                                    </div>
                                    
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Design de "Agenda Vazia" mais elegante -->
                        <div class="text-center text-muted py-5 mt-3 rounded" style="background-color: #f8f9fa; border: 1px dashed #dee2e6;">
                            <i class="bi bi-calendar2-x fs-1 d-block mb-3 text-secondary opacity-50"></i>
                            <p class="mb-0 small fw-bold">Agenda livre!</p>
                            <span class="small opacity-75">Nenhuma consulta próxima.</span>
                        </div>
                    }
                </div>
            </div>
        </div>