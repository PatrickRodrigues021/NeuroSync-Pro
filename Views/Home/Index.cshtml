@{
    ViewData["Title"] = "Dashboard";
}

<style>
    /* Fundo padrão do sistema */
    .dashboard-container { background-color: #f1f5f9; min-height: 80vh; padding-bottom: 2rem; }
    
    /* Cartões Premium */
    .dashboard-card { 
        background: white; 
        border-radius: 16px; 
        box-shadow: 0 4px 20px rgba(0,0,0,0.03); 
        padding: 24px; 
        border: none; 
        height: 100%;
    }
    
    /* Caixas de ícones dos mini-cards */
    .icon-box {
        width: 54px; 
        height: 54px; 
        border-radius: 14px; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        font-size: 1.5rem;
    }
</style>

<div class="dashboard-container pt-3">
    
    <!-- CABEÇALHO -->
    <div class="mb-4">
        <h3 class="fw-bold mb-1" style="color: var(--text-dark);">Visão Geral</h3>
        <p class="text-muted fw-bold mb-0">Acompanhe os indicadores da sua clínica em tempo real.</p>
    </div>

    <!-- LINHA 1: OS 4 CARDS DE INDICADORES -->
    <div class="row g-4 mb-4">
        
        <!-- Pacientes -->
        <div class="col-md-3">
            <div class="dashboard-card d-flex align-items-center">
                <div class="icon-box bg-primary bg-opacity-10 text-primary me-3">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted fw-bold mb-1 small text-uppercase">Pacientes Ativos</h6>
                    <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalPacientes</h3>
                </div>
            </div>
        </div>
        
        <!-- Sessões -->
        <div class="col-md-3">
            <div class="dashboard-card d-flex align-items-center">
                <div class="icon-box bg-success bg-opacity-10 text-success me-3">
                    <i class="bi bi-calendar2-check-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted fw-bold mb-1 small text-uppercase">Sessões (Hoje)</h6>
                    <h3 class="fw-bold text-dark mb-0">@ViewBag.SessoesHoje <span class="fs-6 text-success fw-semibold">/ @ViewBag.SessoesConcluidas concl.</span></h3>
                </div>
            </div>
        </div>
        
        <!-- Pendências -->
        <div class="col-md-3">
            <div class="dashboard-card d-flex align-items-center">
                <div class="icon-box bg-warning bg-opacity-10 text-warning me-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted fw-bold mb-1 small text-uppercase">Pendências</h6>
                    <h3 class="fw-bold text-danger mb-0">@ViewBag.Pendencias</h3>
                </div>
            </div>
        </div>
        
        <!-- Receita -->
        <div class="col-md-3">
            <div class="dashboard-card d-flex align-items-center">
                <div class="icon-box bg-info bg-opacity-10 text-info me-3">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div>
                    <h6 class="text-muted fw-bold mb-1 small text-uppercase">Receita (Mês)</h6>
                    <h3 class="fw-bold text-success mb-0">@(ViewBag.ReceitaMes != null ? ((decimal)ViewBag.ReceitaMes).ToString("C") : "R$ 0,00")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- LINHA 2: LISTA DE ATENDIMENTOS E GRÁFICO (INVERTIDOS!) -->
    <div class="row g-4">
        
        <!-- COLUNA ESQUERDA: PRÓXIMOS ATENDIMENTOS -->
        <div class="col-md-5">
            <div class="dashboard-card">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h5 class="fw-bold text-dark mb-0">Próximos Atendimentos</h5>
                    <a href="/Agenda" class="btn btn-sm btn-light text-primary fw-bold rounded-pill px-3">Ver Agenda</a>
                </div>
                
                @if (ViewBag.ProximosAtendimentos != null && ViewBag.ProximosAtendimentos.Count > 0)
                {
                    foreach (var agendamento in ViewBag.ProximosAtendimentos)
                    {
                        <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                            <!-- Horário -->
                            <div class="me-3 text-center pe-3 border-end">
                                <div class="fw-bold text-primary fs-5">@agendamento.DataHora.ToString("HH:mm")</div>
                            </div>
                            
                            <!-- Nome do Paciente -->
                            <div class="flex-grow-1 ps-2">
                                <h6 class="mb-0 fw-bold text-dark">@(agendamento.Paciente != null ? agendamento.Paciente.Nome : "Sem Nome")</h6>
                                <small class="text-muted fw-semibold">Consulta</small>
                            </div>
                            
                            <!-- Status -->
                            <div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                                    @agendamento.Status
                                </span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-cup-hot mb-3" style="font-size: 3rem;"></i>
                        <h6 class="fw-bold">Nenhum atendimento pendente para hoje!</h6>
                        <p class="small">Aproveite para organizar seus relatórios.</p>
                    </div>
                }
            </div>
        </div>

        <!-- COLUNA DIREITA: GRÁFICO -->
        <div class="col-md-7">
            <div class="dashboard-card">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Status das Sessões</h5>
                        <p class="text-muted mb-0 small fw-semibold">Mês de @ViewBag.NomeMes • Total: @ViewBag.TotalMes sessões</p>
                    </div>
                    <div class="icon-box bg-light text-muted" style="width: 40px; height: 40px;">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>
                </div>
                
                <!-- Onde o Gráfico será desenhado -->
                <div style="height: 300px; width: 100%; display: flex; justify-content: center;">
                    <canvas id="graficoSessoes"></canvas>
                </div>
            </div>
        </div>
        
    </div>
</div>

@section Scripts {
    <!-- 1. Importa a biblioteca Chart.js direto da internet -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- 2. Cria o Gráfico interativo usando os dados do C# -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('graficoSessoes').getContext('2d');
            
            new Chart(ctx, {
                type: 'doughnut', // Gráfico estilo rosca
                data: {
                    labels: ['Realizadas', 'Agendadas', 'Canceladas', 'Faltas'],
                    datasets: [{
                        // Puxando os dados reais das ViewBags
                        data: [
                            @(ViewBag.Realizadas ?? 0), 
                            @(ViewBag.Agendadas ?? 0), 
                            @(ViewBag.Canceladas ?? 0), 
                            @(ViewBag.Faltas ?? 0)
                        ],
                        backgroundColor: ['#10b981', '#3b82f6', '#ef4444', '#f59e0b'],
                        borderWidth: 0,
                        hoverOffset: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right', labels: { font: { family: "'Segoe UI', sans-serif", size: 13, weight: '600' }, color: '#475569', padding: 20 } }
                    },
                    cutout: '75%'
                }
            });
        });
    </script>
}
