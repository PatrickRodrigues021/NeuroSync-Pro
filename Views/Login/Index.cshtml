@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - NeuroSync</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        :root {
            --navy: #071A3A;
            --navy-light: #102B55;
            --primary: #315BEF;
            --cyan: #16C4C8;
            --background: #F7F9FC;
            --text: #172554;
            --muted: #64748B;
        }

        body {
            background-color: var(--background);
            color: var(--text);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
            height: 100vh;
        }

        /* --- ESTILOS DA BARRA LATERAL ESCURA --- */
        .bg-navy { background-color: var(--navy); }
        .text-cyan { color: var(--cyan); }
        
        .btn-primary-custom { background-color: var(--primary); border-color: var(--primary); color: white; transition: 0.3s; }
        .btn-primary-custom:hover { background-color: #2546c7; color: white; }

        .input-dark { background-color: var(--navy-light); border: 1px solid rgba(255,255,255,0.1); color: white; }
        .input-dark:focus { background-color: var(--navy-light); border-color: var(--cyan); color: white; box-shadow: none; }
        .input-dark::placeholder { color: #8ba3cb; font-size: 0.9rem; }
        
        .input-group-text-dark { background-color: var(--navy-light); border: 1px solid rgba(255,255,255,0.1); color: #8ba3cb; border-right: none; }
        .form-control.input-dark { border-left: none; }
        .form-check-input:checked { background-color: var(--primary); border-color: var(--primary); }
    </style>
</head>
<body>
    <div class="container-fluid p-0 h-100">
        <div class="row g-0 h-100">
            
            <!-- ========================================== -->
            <!-- COLUNA ESQUERDA: LOGIN                     -->
            <!-- ========================================== -->
            <div class="col-12 col-lg-4 bg-navy d-flex flex-column justify-content-between p-4 p-md-5 shadow-lg position-relative z-3 h-100">
                
                <div>
                    <div class="d-flex align-items-center mb-4 mt-3">
                        <i class="bi bi-modem text-primary fs-1 me-2" style="filter: drop-shadow(0 0 8px var(--primary));"></i>
                        <h2 class="text-white fw-bold mb-0">Neuro<span class="text-cyan">Sync</span></h2>
                    </div>
                    <p class="text-white-50 mb-5" style="max-width: 280px; font-size: 1.1rem;">Gestão Clínica & <br>Prontuário Eletrônico <br>do Paciente (PEP)</p>
                </div>

                <div class="mb-5">
                    <form method="post" action="/Login/Entrar">
                        @if (ViewBag.Erro != null)
                        {
                            <div class="alert alert-danger text-center small fw-bold py-2 mb-3">
                                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Erro
                            </div>
                        }
                        
                        <div class="mb-4">
                            <label class="form-label text-white fw-bold small mb-2">E-mail ou usuário</label>
                            <div class="input-group">
                                <span class="input-group-text input-group-text-dark rounded-start-3"><i class="bi bi-person"></i></span>
                                <input type="text" name="usuario" class="form-control input-dark py-2 rounded-end-3" placeholder="Digite seu e-mail ou usuário">
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label text-white fw-bold small mb-2">Senha</label>
                            <div class="input-group">
                                <span class="input-group-text input-group-text-dark rounded-start-3"><i class="bi bi-lock"></i></span>
                                <input type="password" name="senha" class="form-control input-dark py-2" placeholder="Digite sua senha">
                                <span class="input-group-text input-group-text-dark rounded-end-3" style="border-left: none; border-right: 1px solid rgba(255,255,255,0.1); cursor: pointer;"><i class="bi bi-eye"></i></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe" style="background-color: var(--navy-light); border-color: rgba(255,255,255,0.2);">
                                <label class="form-check-label text-white-50 small mt-1" for="rememberMe">
                                    Lembrar meu acesso
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary-custom w-100 py-3 d-flex justify-content-between align-items-center fw-bold rounded-3 shadow">
                            <span class="mx-auto ps-3">Entrar</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                        
                        <div class="text-center mt-4">
                            <a href="#" class="text-cyan text-decoration-none small fw-bold">Esqueci minha senha</a>
                        </div>
                    </form>
                </div>

                <div class="text-white-50 small mb-3">
                    <div class="d-flex align-items-center mb-4 border-bottom border-secondary pb-4">
                        <i class="bi bi-shield-check text-cyan fs-2 me-3"></i>
                        <span style="font-size: 0.9rem;">Seus dados protegidos<br>com segurança e conformidade</span>
                    </div>
                    <div style="font-size: 0.8rem;" class="opacity-75">
                        <p class="mb-1">© 2026 NeuroSync • Todos os direitos reservados</p>
                        <p class="mb-0">Versão 1.0.0</p>
                    </div>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- COLUNA DIREITA (A Sua Solução de Fundo)    -->
            <!-- ========================================== -->
            <!-- DICA: Esse #f4f6fa é um azul/cinza clarinho. Se a borda da sua imagem for um pouco diferente, você pode mudar esse código de cor! -->
            <div class="col-lg-8 d-none d-lg-flex flex-column h-100" style="background-color: #f4f6fa;">
                
                <!-- TEXTO MAIS HORIZONTAL (Aumentei o max-width para 900px e tirei a quebra de linha do título) -->
                <div class="p-5 flex-shrink-0" style="z-index: 2;">
                    <h1 class="fw-bolder mb-3" style="font-size: 2.8rem; color: var(--navy);">
                        Gestão inteligente. <span class="text-cyan">Cuidado integrado.</span>
                    </h1>
                    <p class="text-muted mb-0" style="font-size: 1.15rem; max-width: 900px; font-weight: 500;">
                        Um sistema completo de Gestão Clínica e Prontuário Eletrônico do Paciente (PEP), 
                        projetado com foco em clínicas de terapias e neurodesenvolvimento.
                    </p>
                </div>
                
                <!-- IMAGEM (contain = não corta a imagem, mas preenche o espaço restante) -->
                <div class="flex-grow-1 d-flex justify-content-center align-items-start w-100 pb-4" style="min-height: 0; z-index: 1;">
                    <img src="/images/Background-tela-login.png" 
                         style="max-height: 100%; width: 100%; object-fit: contain; object-position: center top;" 
                         alt="Ilustração NeuroSync" />
                </div>
                
            </div>

        </div>
    </div>
</body>
</html>