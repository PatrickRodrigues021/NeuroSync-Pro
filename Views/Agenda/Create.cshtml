@model NeuroSync.Models.Agendamento

@{
    ViewData["Title"] = "Nova Sessão";
}

<div class="container mt-4 mb-5">
    <h2 class="text-primary"><i class="bi bi-calendar-plus"></i> Agendar Sessão</h2>
    <p class="text-muted">Marque um novo atendimento preenchendo os dados abaixo.</p>
    <hr />

    <div class="card shadow-sm border-0 mt-4" style="max-width: 600px;">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                
                <!-- CAIXA DE SELEÇÃO DE PACIENTES (Inteligente) -->
                <div class="mb-4">
                    <label asp-for="PacienteId" class="control-label fw-bold">Selecione o Paciente *</label>
                    <select asp-for="PacienteId" id="buscaPaciente" class="form-select" asp-items="ViewBag.Pacientes" required>
                        <option value="">-- Buscar paciente... --</option>
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label asp-for="DataHora" class="control-label fw-bold">Data e Horário *</label>
                        <input asp-for="DataHora" type="datetime-local" class="form-control" required />
                    </div>
                    
                    <div class="col-md-6 mb-4">
                        <label asp-for="TipoSessao" class="control-label fw-bold">Tipo de Sessão</label>
                        <select asp-for="TipoSessao" class="form-select">
                            <option value="Intervenção">Intervenção (Rotina)</option>
                            <option value="Avaliação">Avaliação</option>
                            <option value="Devolutiva">Devolutiva com os Pais</option>
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Observacoes" class="control-label fw-bold">Observações (Opcional)</label>
                    <textarea asp-for="Observacoes" class="form-control" rows="3" placeholder="Ex: Focar em testes de leitura hoje..."></textarea>
                </div>

                <!-- Status escondido -->
                <input type="hidden" asp-for="Status" value="Agendado" />

                <div class="text-end mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-2">Cancelar</a>
                    <button type="submit" class="btn btn-success fw-bold"><i class="bi bi-check-lg"></i> Confirmar Agendamento</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SCRIPT QUE TRANSFORMA A CAIXINHA EM UMA BARRA DE PESQUISA -->
@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#buscaPaciente').select2({
                placeholder: "Digite o nome da criança para buscar...",
                allowClear: true,
                width: '100%' 
            });
        });
    </script>
}