@model IEnumerable<NeuroSync.Models.Agendamento>

@{
    ViewData["Title"] = "Agenda";
}

<div class="container mt-4 mb-5">
    
    <!-- Cabeçalho com o botão de Novo Agendamento -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary mb-0"><i class="bi bi-calendar3"></i> Agenda de Sessões</h2>
        <a asp-action="Create" class="btn btn-success fw-bold shadow-sm">
            <i class="bi bi-plus-lg"></i> Novo Agendamento
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-4">Data e Horário</th>
                            <th>Paciente</th>
                            <th>Tipo de Sessão</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <!-- A Data formatada bonitinha (ex: 25/10/2026 às 14:30) -->
                                    <td class="ps-4 fw-bold">@item.DataHora.ToString("dd/MM/yyyy 'às' HH:mm")</td>
                                    
                                    <!-- Aqui ele puxa o nome graças ao .Include() que fizemos no C# -->
                                    <td>@(item.Paciente != null ? item.Paciente.Nome : "Paciente Excluído")</td>
                                    
                                    <td>@item.TipoSessao</td>
                                    
                                    <td>
                                        <!-- Cores dinâmicas para o Status -->
                                        @if(item.Status == "Agendado") {
                                            <span class="badge bg-primary rounded-pill px-3">@item.Status</span>
                                        } else if (item.Status == "Realizado") {
                                            <span class="badge bg-success rounded-pill px-3">@item.Status</span>
                                        } else {
                                            <span class="badge bg-danger rounded-pill px-3">@item.Status</span>
                                        }
                                    </td>
                                    
                                    <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.IdAgendamento" class="btn btn-sm btn-outline-secondary" title="Alterar Status">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdAgendamento" class="btn btn-sm btn-outline-danger" title="Cancelar Sessão">
                                            <i class="bi bi-x-circle"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                                    Nenhuma sessão agendada no momento.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>